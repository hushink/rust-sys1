# Copy to sys1.toml (or pass --config). All values below are optional and
# override the built-in defaults. Precedence: CLI > environment > this file.
#
# Relative cache/model paths are resolved from this file's directory.

[hub]
# Model download/cache directory.
cache_dir = "D:/models/sys1-cache"
# Maximum bytes kept under the model cache. Omit or use 0 for unlimited.
# Before a pull, least-recently-used non-resident entries are evicted.
# max_cache_bytes = 34359738368
# offline = false
# hf_endpoint = "https://huggingface.co"
# modelscope_endpoint = "https://modelscope.cn"
# Metadata/connection timeout.
# timeout_secs = 60
# Per-attempt download timeout. Large files resume with HTTP ranges, so this
# bounds stalls rather than the total transfer time.
# download_timeout_secs = 300
# Prefer HF_TOKEN / MODELSCOPE_API_TOKEN / SYS1_HUB_TOKEN environment variables
# for credentials; these fields are available for self-contained deployments.
# hf_token = "..."
# modelscope_token = "..."
# http_token = "..."

[server]
# bind = "127.0.0.1:8080"
# api_key = "..."              # prefer SYS1_API_KEY
# device = "auto"              # auto | cpu | cuda:0 | metal
# dtype = "auto"               # auto | f32 | f16 | bf16
# max_len = 1024
# laya_confidence = "typesafe" # typesafe | laya
# laya_router_default = "multilingual"  # english | multilingual | typed-decisions
# laya_auto_task_detection = false      # opt in to typed-decisions workflow matching
# laya_lang_guess = "en"                # router-wide language hint
# batch_max = 32
# batch_wait_ms = 2
# max_attention_elements = 67108864  # batch*heads*seq² cap per forward chunk
# batch = true                 # false disables cross-request batching
# tf32 = false                 # F32 CUDA GEMMs
# local_window = true          # exact local-window attention (CUDA, >=512 tokens)
# admin = true                 # /api/models load/unload/register endpoints
# metrics = true               # /metrics (Prometheus) and /api/metrics (JSON)
# preload = ["laya-latest"]    # load before the server starts accepting requests
# log_level = "info"           # tracing filter; RUST_LOG is also honored
# log_format = "text"          # text | json
# log_file = "sys1.log"        # append to a file instead of stdout
# cors_origins = ["https://app.example"]  # [] disables CORS; omit = permissive

# Per-family overrides. Encoder families fall back to [server] max_len.
[families]
# Cross-request batch size for NLI/GLiClass/Von/Decima (default 32).
# max_batch = 32

# [families.qwen3guard]
# max_len = 32768

# [families.von]
# max_len = 8192

# [families.clef]
# max_len = 8192

# [families.decima]
# Override `choice_fit` from decima.json.
# choice_fit = false

# [families.kev]
# Qwen3.5 base directory. Relative paths resolve from this file. When unset,
# the base beside the adapter, under base/, or the repository declared in
# head.pt / adapter_config.json is used (and pulled on demand).
# base_dir = "D:/models/qwen3.5-0.8b-base"
# Override the calibrated pointer temperature (kev.json / head.pt otherwise).
# temperature = 2.351

# [families.decision]
# Override the endpoint temperature from the checkpoint calibration.
# temperature = 1.0

# Serving model catalog. Keys are the names clients pass to /v1/systemone.
# Values are ModelRefs: local:/path, hf:owner/repo, modelscope:..., or a
# manifest URL. The same names work with `sys1 run`, `pull`, `show`, and `rm`.
# `POST /api/config/reload` applies [models] additions/removals; other changes
# require a restart.
#
# A local ONNX export directory (model.onnx or an onnx.json sidecar, plus
# rl_agent_config.json and a tokenizer) uses the same local: syntax. ONNX
# Runtime is loaded dynamically at model load time; set ORT_DYLIB_PATH when
# the shared library is not on the platform loader path.
[models]
laya-latest = "local:D:/models/laya"
# laya-onnx = "local:D:/models/laya-onnx"
# laya-multilingual = "hf:convaiinnovations/laya-multilingual"
# laya-typed-decisions = "https://example.com/models/laya-typed-decisions/model.json"
# Candle families are detected from the checkpoint layout/config:
# nli = "hf:MoritzLaurer/ModernBERT-base-zeroshot-v2.0"
# gliclass = "hf:knowledgator/gliclass-instruct-edge-v1.0"
# qwen3guard = "hf:Qwen/Qwen3Guard-Gen-0.6B"
# von = "hf:wfzyx/von"
# decima = "hf:amyrmahdy/decima-base"
# decision = "hf:vllm-sr/Decision-1.0-Eos-0.8B"
# clef = "hf:Cloudflare/clef-flash"
# Kev pulls the Qwen3.5 base declared by the adapter when it is not present
# beside the adapter or under base/:
# kev = "hf:jaredpalmer/kev-0.8b"
