{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/sys1/model-manifest.schema.json",
  "title": "rust-sys1 model manifest",
  "description": "The model.json served by a static HTTP model center. Additional properties are ignored by rust-sys1.",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "description",
    "release_date",
    "family",
    "backend",
    "format",
    "version",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "release_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "variant": {
      "type": ["string", "null"]
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "size"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "^[^\\\\]+$"
            },
            {
              "not": {
                "pattern": "^/"
              }
            },
            {
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            }
          ]
        },
        "url": {
          "type": "string",
          "default": ""
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "git_sha1": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
